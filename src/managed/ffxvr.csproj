<!--
  FFX VR - Fahrenheit mod project.

  The SDK version must match the Fahrenheit build in _ext\fahrenheit.
  Both come from the same commit; see docs\setup.md for why that matters.
-->
<Project Sdk="Fahrenheit.Sdk/1.0.0-alpha12">
    <PropertyGroup>
        <!-- Mod id, and the name of the DLL on disk. Goes in 'loadorder'. -->
        <AssemblyName>ffxvr</AssemblyName>

        <AssemblyTitle>FFX VR</AssemblyTitle>
        <Product>FFX VR</Product>
        <Description>VR support for Final Fantasy X HD Remaster.</Description>
        <Version>0.1.0-dev</Version>
        <Authors>mrpapa</Authors>

        <RepositoryType></RepositoryType>
        <RepositoryUrl></RepositoryUrl>
        <FhManifestHomePage></FhManifestHomePage>

        <!--
          Enum-valued, so it must be a real member, not empty: an empty string fails
          to deserialize and kills the bootloader before it can log anything.
          NONE = we do not need SEPARATE_SAVES; the mod does not alter saves.
        -->
        <FhManifestFlags>NONE</FhManifestFlags>
    </PropertyGroup>
</Project>
