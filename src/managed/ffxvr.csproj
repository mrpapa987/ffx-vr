<!--
  FFX VR - Fahrenheit mod project.

  The SDK version must equal $FfxvrFhVersion in tools\paths.ps1 (the Fahrenheit release FFX VR is
  tested with); build-mod checks. Restored from nuget.org into _ext\nuget (nuget.config next to this file).
-->
<Project Sdk="Fahrenheit.Sdk/1.0.0-alpha12">
    <PropertyGroup>
        <!-- Mod id, and the name of the DLL on disk. Goes in 'loadorder'. -->
        <AssemblyName>ffxvr</AssemblyName>

        <AssemblyTitle>FFX VR</AssemblyTitle>
        <Product>FFX VR</Product>
        <Description>VR support for Final Fantasy X HD Remaster.</Description>
        <!--
          The version, in one place (docs\release.md, "Release procedure"): the assembly's informational version
          (shown in the F8 overlay, at the top of ffxvr_diag.log), ffxvr.manifest.json, the native DLL's version string
          (build-mod writes src\native\ffxvr_version.h from it) and the release zip's name. The git tag is v + this.
          SemVer: 0.x while the mod is young; -alpha.N while it has been tested on one setup only.
        -->
        <Version>0.1.0-alpha.1</Version>
        <Authors>mrpapa</Authors>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/mrpapa987/ffx-vr</RepositoryUrl>
        <FhManifestHomePage></FhManifestHomePage>

        <!--
          Enum-valued, so it must be a real member, not empty: an empty string fails
          to deserialize and kills the bootloader before it can log anything.
          NONE = we do not need SEPARATE_SAVES; the mod does not alter saves.
        -->
        <FhManifestFlags>NONE</FhManifestFlags>
    </PropertyGroup>
</Project>
