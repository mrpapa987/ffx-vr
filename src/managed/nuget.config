<?xml version="1.0" encoding="utf-8"?>
<!-- FFX VR: packages from nuget.org only, into a package folder of this repo's own (_ext\nuget, not in git). A local
     Fahrenheit build and the official release share the version string, so neither a global source nor the global cache
     may decide which one we compile against. tools\build-mod.ps1 checks where each Fahrenheit package came from.
     If Fahrenheit.Sdk is ever missing from nuget.org, docs\design-notes.md (Fahrenheit port) has a fallback block. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <config>
    <add key="globalPackagesFolder" value="..\..\_ext\nuget" />
  </config>
</configuration>
