<?xml version="1.0" encoding="utf-8"?>
<!--
  Fahrenheit's SDK and core package are not on nuget.org at the version we need
  (1.0.0-alpha12 is our own build from main). They come from the local build
  output instead. Run tools\build-fahrenheit-full.ps1 before building this mod.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="fahrenheit-local" value="..\..\_ext\fahrenheit\artifacts\pkg\rel" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
