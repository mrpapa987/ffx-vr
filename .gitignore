# Visual Studio / MSBuild
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
.vs/
artifacts/
*.user
*.suo
*.pdb

# CMake / vcpkg
build/
out/
vcpkg_installed/

# Logs from the build-and-run loop
logs/*
!logs/.gitkeep

# RenderDoc captures: large, and they contain game assets
*.rdc
*.cap
captures/

# Never commit anything from the game install
game/
*.vbf
*.phyre

# Downloaded installers, not source
_staging/

# External sources cloned for building
_ext/

# Native build output
src/native/bin/
src/native/obj/

# downloads (texture packs etc.)
*.7z
*.7z.*
*.crdownload

# Per-machine path override for the tools (see tools/paths.ps1)
tools/paths.local.ps1

# Release zips (tools/package-release.ps1)
dist/

# Generated by tools/build-mod.ps1 (the native version string)
src/native/ffxvr_version.h

# Hand packs: only assets/hands/generic* are ours (tools/hands/make-generic-hand.py, MIT). Packs made from a user's own
# models (often game-derived) must never be committed. Anchored patterns only: tools/hands/ is not matched.
/hands/
/assets/hands/*
!/assets/hands/generic/
!/assets/hands/generic-glove/
PRIVATE-do-not-share.txt
*.private.glb

# Python bytecode (tools/hands)
__pycache__/
*.pyc

# Importer previews (pictures of a user's model): never committed, wherever they land
preview*.png
debug-preview.png

# FMV depth (tools/fmvdepth/convert.py) and its previews: derived from the game's videos. Never committed, wherever they
# land: any folder named fmvdepth, except tools/fmvdepth/ (the converter's source), re-included below.
**/fmvdepth/
!/tools/fmvdepth/
*.fvd
*.fvd.part
*_preview.mp4
*_preview.mp4.part.mp4
*_frame[0-9]*.png

# The Bushido target art pack: the owner's own AI-generated art, local only (tools/target-art; docs "Bushido target art")
assets/art/
